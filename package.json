{
  "name": "orpheon-windows",
  "version": "0.2.0",
  "private": true,
  "description": "A Windows desktop companion for Orpheon, built as an independent desktop port.",
  "main": "dist-electron/main.js",
  "author": "sssmmmSK",
  "license": "GPL-3.0-only",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "npm run typecheck && vite build && electron-builder --win nsis --publish never",
    "build:dir": "npm run typecheck && vite build && electron-builder --win dir --publish never",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc -p tsconfig.electron.json"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1",
    "@types/ws": "^8.5.13"
  },
  "build": {
    "appId": "com.sssmmm.orpheonwindows",
    "productName": "Orpheon Windows",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "electron/player-bridge.js",
      "LICENSE",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
